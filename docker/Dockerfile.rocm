ARG REPO_DIR=/workspace/MetaAttention
FROM rocm/pytorch:rocm6.3.2_ubuntu22.04_py3.10_pytorch_release_2.4.0

ARG REPO_DIR
WORKDIR /workspace

RUN pip install uv
RUN uv pip install --system "numpy<2.0" einops jinja2 matplotlib pandas sympy termcolor
RUN USE_LLVM=True USE_ROCM=True uv pip install --system "tilelang @ git+https://github.com/tile-ai/tilelang.git@v0.1.11"

# Install MetaAttention itself via uv without re-resolving the ROCm base runtime stack
COPY . ${REPO_DIR}
WORKDIR ${REPO_DIR}
RUN uv pip install --system --no-deps -e .

RUN pip install flash-attn==2.7.4.post1 --no-build-isolation

RUN git clone https://github.com/fla-org/flash-linear-attention.git \
    && cd flash-linear-attention \
    && git checkout v0.2.0 \
    && mv fla/__init__.py fla/__init__.py.bak \
    && mv fla/ops/__init__.py fla/ops/__init__.py.bak

RUN git clone https://github.com/state-spaces/mamba.git \
    && cd mamba \
    && git checkout v2.2.6.post3 \
    && mv mamba_ssm/__init__.py mamba_ssm/__init__.py.bak

CMD ["bash"]
