ARG REPO_DIR=/workspace/MetaAttention
FROM rocm/pytorch:rocm6.3.2_ubuntu22.04_py3.10_pytorch_release_2.4.0

ARG REPO_DIR
WORKDIR /workspace

RUN pip install uv
RUN uv pip install --system "numpy<2.0" einops jinja2 matplotlib pandas sympy termcolor tilelang

# Install MetaAttention itself via uv without re-resolving the ROCm base runtime stack
COPY . ${REPO_DIR}
WORKDIR ${REPO_DIR}
RUN uv pip install --system --no-deps -e .



CMD ["bash"]
