ARG REPO_DIR=/workspace/MetaAttention
FROM nvcr.io/nvidia/pytorch:25.02-py3

ARG REPO_DIR
WORKDIR /workspace

# 1. Install uv and Python dependencies needed by MetaAttention and benchmarks
RUN pip install uv
RUN uv pip install --system "numpy<2" einops jinja2 matplotlib pandas sympy termcolor triton==3.2.0 transformers==4.45.0 tilelang

# 2. Install MetaAttention itself via uv without re-resolving the base runtime stack
COPY . ${REPO_DIR}
WORKDIR ${REPO_DIR}
RUN uv pip install --system --no-deps -e .


CMD ["bash"]
